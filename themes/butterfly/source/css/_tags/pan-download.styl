#article-container .tip.toc-heading,
.game-quickview__article .tip.toc-heading
  padding: 6px 20px

  h1,
  h2,
  h3,
  h4,
  h5,
  h6
    position: relative
    margin: 0 !important
    padding: .5rem 0 !important
    color: #fff !important
    font-size: 16px !important
    font-weight: 600
    line-height: 1.5

    &:before,
    &:after
      display: none !important
      content: none !important

    &:hover
      padding-left: 0 !important

    a.headerlink
      display: none !important

#article-container blockquote.post-pan-download-quote,
.game-quickview__article blockquote.post-pan-download-quote
  box-sizing: border-box
  margin: 18px 0
  padding: 12px 15px
  border-left: 3px solid #007af3
  background: rgba(0, 122, 243, .08)

.post-pan-download
  display: block
  width: 100%
  max-width: 100%
  box-sizing: border-box
  margin: 0
  padding: 7px
  border: 1px solid rgba(0, 122, 243, .28)
  border-radius: 8px
  background: linear-gradient(180deg, rgba(248, 252, 255, .78), rgba(226, 242, 255, .52))
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .64), 0 8px 22px rgba(0, 122, 243, .08)

.post-pan-download__body
  display: flex
  align-items: center
  min-height: 54px

#article-container .post-pan-download > p,
.game-quickview__article .post-pan-download > p
  margin: 4px 0 4px 34px

.post-pan-download__icon
  display: inline-flex
  flex: 0 0 28px
  align-items: center
  justify-content: center
  width: 28px
  height: 28px
  margin-right: 6px
  color: #007af3
  font-size: 17px

.post-pan-download__links
  display: flex
  flex-wrap: wrap
  gap: 5px
  flex: 1 1 auto
  min-width: 0

#article-container .post-pan-download button.post-pan-download__item,
.game-quickview__article .post-pan-download button.post-pan-download__item
  display: inline-flex
  flex: 0 0 112px
  align-items: center
  justify-content: center
  gap: 4px
  box-sizing: border-box
  min-width: 0
  height: 38px
  padding: 0 7px
  border: 1px solid rgba(0, 122, 243, .3)
  border-radius: 7px
  color: #111827
  background: rgba(255, 255, 255, .7)
  box-shadow: 0 6px 14px rgba(0, 122, 243, .08)
  font-size: 12px
  font-weight: 700
  font-family: inherit
  cursor: pointer
  text-decoration: none
  transition: border-color .2s ease, background .2s ease, box-shadow .2s ease, color .2s ease, transform .2s ease

  &:before,
  &:after
    display: none !important
    content: none !important

  &:hover:not(:disabled),
  &:focus-visible
    border-color: #007af3
    border-radius: 7px
    color: #fff
    background: #007af3
    box-shadow: 0 8px 18px rgba(0, 122, 243, .26)
    text-decoration: none
    transform: translateY(-1px)

  &:focus-visible
    outline: 2px solid #007af3
    outline-offset: 3px

  &:disabled
    opacity: .6
    cursor: wait

  &.is-unavailable
    cursor: not-allowed
    box-shadow: none

.post-pan-download__mark
  display: inline-flex
  align-items: center
  justify-content: center
  flex: 0 0 18px
  width: 18px
  height: 18px
  overflow: hidden
  border-radius: 4px
  line-height: 1

#article-container .post-pan-download .post-pan-download__mark img,
.game-quickview__article .post-pan-download .post-pan-download__mark img
  display: block
  width: 100%
  height: 100%
  margin: 0
  object-fit: contain

.post-pan-download__name
  min-width: 0
  overflow: hidden
  white-space: nowrap
  text-overflow: ellipsis

[data-theme='dark']
  #article-container blockquote.post-pan-download-quote,
  .game-quickview__article blockquote.post-pan-download-quote
    border-left-color: #7dd3fc
    background: rgba(0, 122, 243, .1)

  .post-pan-download
    border-color: rgba(125, 211, 252, .24)
    background: linear-gradient(180deg, rgba(18, 44, 64, .54), rgba(10, 28, 45, .48))
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), 0 8px 22px rgba(0, 0, 0, .14)

  #article-container .post-pan-download button.post-pan-download__item,
  .game-quickview__article .post-pan-download button.post-pan-download__item
    border-color: rgba(125, 211, 252, .24)
    color: #eaf7ff
    background: rgba(21, 38, 56, .78)

    &:hover:not(:disabled),
    &:focus-visible
      color: #fff
      background: #007af3

@media screen and (max-width: 520px)
  #article-container blockquote.post-pan-download-quote,
  .game-quickview__article blockquote.post-pan-download-quote
    padding: 10px

  #article-container .post-pan-download button.post-pan-download__item,
  .game-quickview__article .post-pan-download button.post-pan-download__item
    flex: 1 1 104px
    padding: 0 4px
    font-size: 11px

