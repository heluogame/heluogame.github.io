#recent-posts
  & > .home-game-nav
    display: none

    +maxWidth768()
      display: grid
      grid-template-columns: repeat(2, minmax(0, 1fr))
      gap: 10px
      margin-top: 14px

      & + .recent-post-item:not(:first-child)
        margin-top: 14px

      .home-game-nav-title
        display: flex
        grid-column: 1 / -1
        align-items: center
        gap: 8px
        color: #fff
        font-size: 14px
        font-weight: 400
        line-height: 20px
        letter-spacing: 0
        text-shadow: 0 1px 3px rgba(0, 0, 0, .7)

        &:before
          width: 3px
          height: 14px
          border-radius: 2px
          background: #5ca1ff
          content: ''

        &:after
          flex: 1
          height: 1px
          background: rgba(92, 161, 255, .3)
          content: ''

      .home-game-nav-link
        display: flex
        align-items: center
        justify-content: center
        gap: 9px
        min-width: 0
        min-height: 58px
        padding: 12px 14px
        border: 1px solid rgba(72, 143, 235, .55)
        border-radius: 8px
        background: #eaf3ff
        color: #21528b
        font-size: 15px
        font-weight: 400
        line-height: 1.5
        letter-spacing: 0
        transition: background .18s ease, border-color .18s ease

        &:hover,
        &:active
          border-color: #5ca1ff
          background: #dcecff

        &:focus-visible
          outline: 2px solid #5ca1ff
          outline-offset: 3px

        span
          min-width: 0

      .home-game-nav-icon
        flex-shrink: 0
        color: #2373d2
        font-size: 19px

      [data-theme='dark'] & .home-game-nav-link
        border-color: #386194
        background: #182a40
        color: #eaf3ff

        &:hover,
        &:active
          border-color: #5ca1ff
          background: #203752

        .home-game-nav-icon
          color: #5ca1ff

  & > .recent-post-item:not(:first-child)
    margin-top: 20px

  & > .recent-post-item
    @extend .cardHover
    display: flex
    flex-direction: row
    align-items: center
    overflow: hidden
    height: 18em

    +maxWidth768()
      flex-direction: column
      height: auto

    &:hover
      img.post_bg
        transform: scale(1.1)

    &.ads-wrap
      display: block !important
      height: auto !important

    .post_cover
      overflow: hidden
      width: 44%
      height: 100%

      +maxWidth768()
        width: 100%
        height: 230px

      img.post_bg
        @extend .imgHover

      &.right
        order: 1

        +maxWidth768()
          order: 0

    & >.recent-post-info
      padding: 0 40px
      width: 57%

      +maxWidth768()
        padding: 20px 20px 30px
        width: 100%

      &.no-cover
        width: 100%

        +maxWidth768()
          padding: 30px 20px

      & > .article-title
        @extend .limit-more-line
        color: var(--text-highlight-color)
        font-size: 1.72em
        line-height: 1.4
        transition: all .2s ease-in-out
        -webkit-line-clamp: 2

        +maxWidth768()
          font-size: 1.43em

        &:hover
          color: $text-hover

      & > .article-meta-wrap
        margin: 6px 0
        color: $theme-meta-color
        font-size: 90%

        & > .post-meta-date
          cursor: default

        .sticky
          color: $sticky-color

        i
          margin: 0 4px 0 0

        .fa-spinner
          margin: 0

        .article-meta-label
          if hexo-config('post_meta.page.label')
            padding-right: 4px
          else
            display: none

        .article-meta-separator
          margin: 0 6px

        .article-meta-link
          margin: 0 4px

        if hexo-config('post_meta.page.date_format') == 'relative'
          time
            display: none

        a
          color: $theme-meta-color

          &:hover
            color: $text-hover
            text-decoration: underline

      & > .content
        @extend .limit-more-line
        -webkit-line-clamp: 2
