:root
  --game-catalog-accent: $theme-color
  --game-catalog-accent-rgb: red($theme-color), green($theme-color), blue($theme-color)
  --game-catalog-on-accent: #fff
  --game-catalog-text: #262626
  --game-catalog-panel: rgba(255, 255, 255, .88)
  --game-catalog-panel-solid: #fff
  --game-catalog-heading-bg: rgba(255, 255, 255, .94)
  --game-catalog-heading-muted: #555
  --game-catalog-line: rgba(36, 36, 36, .16)
  --game-catalog-muted: #707070
  --game-catalog-modal: #f7f7f7
  --game-catalog-modal-soft: #fff

[data-theme='dark']
  --game-catalog-on-accent: #202020
  --game-catalog-text: #ededed
  --game-catalog-panel: rgba(24, 24, 24, .88)
  --game-catalog-panel-solid: #181818
  --game-catalog-heading-bg: rgba(24, 24, 24, .94)
  --game-catalog-heading-muted: #c4c4c4
  --game-catalog-line: rgba(255, 255, 255, .16)
  --game-catalog-muted: #aaa
  --game-catalog-modal: #171717
  --game-catalog-modal-soft: #222

#content-inner.layout:has(> .home-catalog-section)
  display: block
  max-width: 1540px

  > #aside-content
    display: none

.home-notice
  display: flex
  align-items: stretch
  gap: 8px
  margin-bottom: 16px
  padding: 6px
  width: 100%
  min-height: 60px
  border: 1px solid unquote('rgba(var(--game-catalog-accent-rgb), .3)')
  border-radius: 8px
  background: linear-gradient(unquote('rgba(var(--game-catalog-accent-rgb), .1)'), unquote('rgba(var(--game-catalog-accent-rgb), .1)')), var(--game-catalog-panel)
  box-shadow: 0 4px 14px rgba(0, 0, 0, .04)
  color: var(--game-catalog-heading-muted)
  font-size: 14px
  line-height: 1.5

.home-notice__label
  display: flex
  flex: 0 0 88px
  align-items: center
  justify-content: center
  gap: 8px
  border-right: 1px solid unquote('rgba(var(--game-catalog-accent-rgb), .2)')
  color: var(--game-catalog-accent)
  white-space: nowrap

  > i
    font-size: 16px

  > strong
    font-size: 15px

.home-notice__body
  display: flex
  flex: 1 1 auto
  align-items: center
  gap: 20px
  padding: 6px 10px 6px 14px
  min-width: 0
  min-height: 46px
  border-radius: 5px
  background: var(--game-catalog-panel)

.home-notice__text
  flex: 1 1 auto
  overflow: hidden
  margin: 0
  min-width: 0
  text-overflow: ellipsis
  white-space: nowrap

.home-notice__links
  display: flex
  flex: 0 0 auto
  align-items: center
  gap: 8px

  a
    display: inline-flex
    align-items: center
    justify-content: center
    gap: 7px
    padding: 5px 10px
    min-height: 32px
    border: 1px solid unquote('rgba(var(--game-catalog-accent-rgb), .22)')
    border-radius: 5px
    background: unquote('rgba(var(--game-catalog-accent-rgb), .07)')
    color: var(--game-catalog-accent)
    font-size: 13px
    white-space: nowrap
    transition: background .2s ease, border-color .2s ease

    &:hover,
    &:focus-visible
      border-color: unquote('rgba(var(--game-catalog-accent-rgb), .5)')
      background: unquote('rgba(var(--game-catalog-accent-rgb), .14)')

    &:focus-visible
      outline: 2px solid var(--game-catalog-accent)
      outline-offset: 3px

    > i
      font-size: 10px

.home-game-catalog-head
  display: flex
  align-items: center
  justify-content: space-between
  gap: 20px
  margin-bottom: 16px
  padding: 14px 18px
  width: 100%
  border: 1px solid var(--game-catalog-line)
  border-radius: 8px
  background: var(--game-catalog-panel)
  box-shadow: 0 6px 20px rgba(0, 0, 0, .06)
  backdrop-filter: blur(12px)

.home-game-catalog-head__title
  display: flex
  align-items: baseline
  min-width: 0
  gap: 9px

  > i
    color: var(--game-catalog-accent)
    font-size: 18px

  > h2
    margin: 0
    color: var(--game-catalog-text)
    font-size: 19px
    line-height: 1.2

  > span
    color: var(--game-catalog-muted)
    font-size: 11px
    letter-spacing: 0

.home-game-catalog-head__guide
  display: inline-flex
  align-items: center
  flex: 0 0 auto
  gap: 7px
  padding: 8px 11px
  border: 1px solid unquote('rgba(var(--game-catalog-accent-rgb), .28)')
  border-radius: 8px
  background: unquote('rgba(var(--game-catalog-accent-rgb), .06)')
  color: var(--game-catalog-accent)
  font-size: 13px
  transition: color .2s ease, background .2s ease, border-color .2s ease

  &:hover
    border-color: unquote('rgba(var(--game-catalog-accent-rgb), .52)')
    background: unquote('rgba(var(--game-catalog-accent-rgb), .12)')
    color: var(--game-catalog-accent)

  .fa-arrow-up-right-from-square
    font-size: 10px
    opacity: .72

.home-catalog-section
  width: 100%

  & + &
    margin-top: 28px

.home-catalog-section__header
  display: flex
  align-items: center
  justify-content: space-between
  gap: 18px
  margin-bottom: 13px
  padding: 8px 14px
  min-height: 46px
  border: 1px solid var(--game-catalog-line)
  border-radius: 8px
  background: linear-gradient(110deg, rgba(255, 255, 255, .08), transparent 65%), var(--game-catalog-heading-bg)
  box-shadow: 0 4px 14px rgba(0, 0, 0, .06)

.home-catalog-section__heading
  display: flex
  align-items: center
  flex: 1 1 auto
  min-width: 0
  gap: 9px

  h2
    overflow: hidden
    margin: 0
    color: var(--game-catalog-text)
    font-size: 19px
    line-height: 1.2
    text-overflow: ellipsis
    white-space: nowrap

.home-catalog-section__marker
  flex: 0 0 auto
  width: 4px
  height: 18px
  border-radius: 2px
  background: var(--game-catalog-accent)

.home-catalog-section__eyebrow
  flex: 0 0 auto
  padding-left: 10px
  border-left: 1px solid var(--game-catalog-line)
  color: var(--game-catalog-heading-muted)
  font-size: 12px
  line-height: 1.2
  letter-spacing: 0
  white-space: nowrap

.home-catalog-section__more
  display: inline-flex
  align-items: center
  flex: 0 0 auto
  gap: 6px
  padding: 4px 6px
  min-height: 28px
  border-radius: 4px
  color: var(--game-catalog-heading-muted)
  font-size: 13px
  font-weight: 400
  line-height: 1.5
  transition: color .2s ease, background .2s ease

  &:hover,
  &:focus-visible
    background: unquote('rgba(var(--game-catalog-accent-rgb), .07)')
    color: var(--game-catalog-accent)

    i
      transform: translateX(2px)

  &:focus-visible
    outline: 2px solid var(--game-catalog-accent)
    outline-offset: 3px

  i
    font-size: 10px
    transition: transform .2s ease

#content-inner .home-section-grid
  display: grid
  grid-template-columns: repeat(5, minmax(0, 1fr))
  gap: 18px
  width: 100%

  > .recent-post-item
    margin: 0 !important

  > .home-section-card
    position: relative
    display: flex
    overflow: hidden
    flex-direction: column
    align-items: stretch
    min-width: 0
    height: auto
    border: 1px solid var(--game-catalog-line)
    border-radius: 8px
    background: var(--game-catalog-panel)
    box-shadow: 0 7px 22px rgba(0, 0, 0, .08)
    cursor: pointer
    isolation: isolate
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease

    &:hover,
    &:focus-within
      border-color: unquote('rgba(var(--game-catalog-accent-rgb), .42)')
      box-shadow: 0 12px 30px rgba(0, 0, 0, .13), 0 0 0 2px unquote('rgba(var(--game-catalog-accent-rgb), .08)')
      transform: translateY(-3px)

      .post_cover img.post_bg
        transform: scale(1.045)

    .post_cover,
    .post_cover.right
      position: relative
      overflow: hidden
      order: 0
      flex: 0 0 auto
      width: 100%
      height: auto
      min-height: 0
      aspect-ratio: unquote('16 / 9')
      background: rgba(24, 24, 24, .08)

      > a
        position: absolute
        inset: 0
        display: block

      img.post_bg
        width: 100%
        height: 100%
        object-fit: cover
        transition: transform .35s ease

    > .recent-post-info
      display: flex
      flex: 0 0 122px
      flex-direction: column
      padding: 12px 14px 13px
      width: 100%
      min-height: 122px

      > .article-title
        display: -webkit-box
        overflow: hidden
        margin: 0
        color: var(--game-catalog-text)
        font-size: 15px
        font-weight: 700
        line-height: 1.5
        -webkit-box-orient: vertical
        -webkit-line-clamp: 3
        transition: color .2s ease

        &:hover
          color: var(--game-catalog-accent)

      > .article-meta-wrap
        display: flex
        overflow: hidden
        align-items: center
        column-gap: 8px
        order: -1
        margin: 0 0 6px
        color: var(--game-catalog-muted)
        font-size: 11px
        white-space: nowrap

        .article-meta-separator,
        .article-meta.tags,
        .article-meta__categories
          display: none

        a
          color: inherit

      > .content
        display: none

  > .ads-wrap
    grid-column: 1 / -1

.has-game-quickview .game-card-markers
  position: absolute
  z-index: 1
  inset: 8px 8px auto
  display: flex
  align-items: flex-start
  gap: 8px
  line-height: 1

  .game-card-badge
    display: block
    overflow: hidden
    padding: 0 7px
    min-width: 0
    height: 22px
    border: 1px solid rgba(255, 255, 255, .6)
    border-radius: 4px
    background: rgba(248, 248, 248, .92)
    box-shadow: 0 2px 6px rgba(0, 0, 0, .14)
    color: #242424
    font-size: 11px
    font-weight: 600
    line-height: 20px
    text-overflow: ellipsis
    white-space: nowrap
    transition: background .2s ease

    &:hover
      background: #fff

  .game-card-platforms
    display: flex
    flex: 0 0 auto
    gap: 4px
    margin-left: auto

  .game-card-platform
    position: relative
    display: inline-flex
    align-items: center
    justify-content: center
    width: 22px
    height: 22px
    border: 1px solid rgba(255, 255, 255, .3)
    border-radius: 5px
    background: rgba(30, 30, 30, .68)
    box-shadow: 0 2px 6px rgba(0, 0, 0, .16)
    color: #fff
    font-size: 14px
    transition: background .2s ease

    &:hover
      background: rgba(65, 65, 65, .88)

    &:after
      position: absolute
      top: calc(100% + 6px)
      right: 0
      visibility: hidden
      padding: 5px 7px
      border-radius: 4px
      background: rgba(25, 25, 25, .94)
      color: #fff
      content: attr(data-tooltip)
      font-size: 11px
      line-height: 1.3
      white-space: nowrap
      opacity: 0
      pointer-events: none
      transition: opacity .15s ease, visibility .15s ease

    &:hover:after
      visibility: visible
      opacity: 1

body.game-quickview-open
  overflow: hidden

.game-quickview
  --game-catalog-on-accent: #fff
  --game-catalog-text: #29282e
  --game-catalog-muted: #74717d
  --game-catalog-line: rgba(59, 90, 140, .15)
  --game-catalog-modal: #f8faff
  --game-catalog-modal-soft: #fff
  --game-detail-inset: #f1f5fb
  --game-detail-button: var(--game-catalog-accent)
  --game-detail-blue: var(--game-catalog-accent)
  --game-detail-blue-rgb: var(--game-catalog-accent-rgb)
  --game-detail-status: #167563
  --game-detail-size: #946314
  padding: 0
  width: calc(100vw - 64px)
  max-width: 1080px
  height: calc(100dvh - 64px)
  max-height: 720px
  border: 1px solid var(--game-catalog-line)
  border-radius: 8px
  background: var(--game-catalog-modal)
  color: var(--game-catalog-text)
  box-shadow: 0 26px 80px rgba(0, 0, 0, .45)

  &::backdrop
    background: rgba(5, 5, 5, .78)
    backdrop-filter: blur(8px)

  &[open]
    animation: gameQuickviewIn .2s ease-out

  button:focus-visible,
  a:focus-visible
    outline: 2px solid var(--game-catalog-accent)
    outline-offset: 3px

[data-theme='dark'] .game-quickview
  --game-catalog-text: #f1f0f3
  --game-catalog-muted: #b3b1bd
  --game-catalog-line: rgba(210, 205, 220, .15)
  --game-catalog-modal: #1b1c20
  --game-catalog-modal-soft: #24252b
  --game-detail-inset: #2c2d35
  --game-detail-status: #73d3bf
  --game-detail-size: #e5c27d

.game-quickview__frame
  display: grid
  grid-template-rows: 52px minmax(0, 1fr)
  overflow: hidden
  width: 100%
  height: 100%

.game-quickview__header
  display: flex
  align-items: center
  justify-content: space-between
  padding: 0 14px 0 20px
  border-bottom: 1px solid var(--game-catalog-line)
  background: var(--game-catalog-modal-soft)

.game-quickview__heading
  display: flex
  align-items: baseline
  gap: 9px
  padding-left: 12px
  border-left: 3px solid var(--game-catalog-accent)

  i
    color: var(--game-catalog-accent)

  strong
    color: var(--game-catalog-text)
    font-size: 16px

  span
    color: var(--game-catalog-muted)
    font-size: 10px
    letter-spacing: 0

.game-quickview__close
  display: inline-grid
  width: 34px
  height: 34px
  border: 1px solid var(--game-catalog-line)
  border-radius: 6px
  background: var(--game-detail-inset)
  color: var(--game-catalog-text)
  cursor: pointer
  font-size: 18px
  place-items: center
  transition: color .2s ease, background .2s ease, border-color .2s ease

  &:hover
    border-color: unquote('rgba(var(--game-catalog-accent-rgb), .45)')
    background: unquote('rgba(var(--game-catalog-accent-rgb), .16)')
    color: var(--game-catalog-accent)

.game-quickview__loading
  display: flex
  align-items: center
  justify-content: center
  gap: 10px
  color: var(--game-catalog-muted)

  i
    color: var(--game-catalog-accent)

  &[hidden]
    display: none

.game-quickview__body
  display: grid
  grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr)
  overflow: hidden
  min-height: 0

  &[hidden]
    display: none

.game-quickview__main,
.game-quickview__summary
  overflow-x: hidden
  overflow-y: auto
  min-height: 0
  scrollbar-color: unquote('rgba(var(--game-catalog-accent-rgb), .35)') transparent
  scrollbar-width: thin

.game-quickview__main
  padding: 18px 20px 24px

.game-quickview__cover
  overflow: hidden
  width: 100%
  aspect-ratio: 16 / 8.7
  border: 1px solid var(--game-catalog-line)
  border-radius: 6px
  background: rgba(12, 12, 12, .14)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover

.game-quickview__tabs
  display: flex
  align-items: stretch
  gap: 4px
  margin-top: 10px
  border-bottom: 1px solid var(--game-catalog-line)

  button
    position: relative
    display: inline-flex
    align-items: center
    padding: 8px 10px
    border: 0
    border-radius: 4px 4px 0 0
    background: transparent
    color: var(--game-catalog-muted)
    cursor: pointer
    font-size: 14px
    transition: color .2s ease, background .2s ease

    &:after
      position: absolute
      right: 50%
      bottom: -1px
      left: 50%
      height: 3px
      border-radius: 3px
      background: var(--game-catalog-accent)
      content: ''
      transition: right .2s ease, left .2s ease

    &:hover,
    &.is-active
      background: unquote('rgba(var(--game-catalog-accent-rgb), .07)')
      color: var(--game-catalog-accent)

      &:after
        right: 10px
        left: 10px

.game-quickview__article
  padding-top: 10px
  color: var(--game-catalog-text)
  font-size: 14px
  line-height: 1.75
  overflow-wrap: anywhere

  > p:first-child:empty
    display: none

  img
    display: block
    margin: 0 auto
    max-width: 100%
    height: auto

  h1,
  h2,
  h3
    margin: 18px 0 10px
    color: var(--game-catalog-text)
    line-height: 1.5

  h1
    font-size: 20px

  h2
    font-size: 18px

  h3
    font-size: 16px

  .tip.toc-heading
    margin: 18px 0 12px
    padding: 12px 16px
    border-radius: 8px
    filter: none

    h1
      margin: 0
      padding: 0
      color: #fff
      font-size: 18px
      line-height: 1.5

      a
        color: inherit

  a
    color: var(--game-catalog-accent)

  .download-password-dialog
    color: var(--game-catalog-text)

.game-quickview__review
  padding: 18px 4px 24px
  color: var(--game-catalog-text)
  font-size: 15px
  line-height: 1.9
  white-space: pre-line
  overflow-wrap: anywhere

  &[hidden]
    display: none

  > [data-game-quickview-review]:not(.is-markdown)
    margin: 0
    padding-left: 14px
    border-left: 3px solid unquote('rgba(var(--game-catalog-accent-rgb), .4)')

  > [data-game-quickview-review].is-markdown
    white-space: normal
    line-height: 1.8

    > :first-child
      margin-top: 0

    > :last-child
      margin-bottom: 0

    p
      margin: 0 0 12px

    ol,
    ul
      margin: 10px 0 14px
      padding-left: 26px

    li
      margin: 6px 0

    h1,
    h2,
    h3,
    h4,
    h5,
    h6
      margin: 18px 0 10px
      color: var(--game-catalog-text)
      font-size: 17px
      line-height: 1.5

    img
      display: block
      max-width: 100%
      height: auto
      margin: 12px auto

    pre,
    figure.highlight
      max-width: 100%
      margin: 12px 0
      overflow: auto
      white-space: pre

    pre
      padding: 12px
      border-radius: 6px
      background: var(--game-catalog-modal-soft)

    code
      font-size: .92em

    a
      color: var(--game-catalog-accent)

    blockquote
      margin: 12px 0
      padding: 8px 14px
      border-left: 3px solid var(--game-catalog-accent)
      background: var(--game-catalog-modal-soft)

.game-quickview__summary
  padding: 20px
  border-left: 1px solid var(--game-catalog-line)
  background: var(--game-catalog-modal-soft)

.game-quickview__summary-head
  display: grid
  grid-template-columns: 64px minmax(0, 1fr)
  align-items: start
  gap: 12px

.game-quickview__thumb
  overflow: hidden
  width: 64px
  height: 64px
  border: 1px solid var(--game-catalog-line)
  border-radius: 6px
  background: rgba(12, 12, 12, .12)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover

.game-quickview__identity
  min-width: 0

  h2
    display: -webkit-box
    overflow: hidden
    margin: 0 0 8px
    color: var(--game-catalog-text)
    font-size: 18px
    line-height: 1.42
    -webkit-box-orient: vertical
    -webkit-line-clamp: 4

.game-quickview__chips
  display: flex
  flex-wrap: wrap
  gap: 5px

  span
    padding: 3px 6px
    border: 1px solid unquote('rgba(var(--game-detail-blue-rgb), .22)')
    border-radius: 4px
    background: unquote('rgba(var(--game-detail-blue-rgb), .09)')
    color: var(--game-detail-blue)
    font-size: 11px

.game-quickview__info
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 1px
  overflow: hidden
  margin-top: 16px
  border: 1px solid var(--game-catalog-line)
  border-radius: 8px
  background: var(--game-catalog-line)

.game-quickview__info-item
  display: flex
  flex-direction: column
  gap: 5px
  min-height: 64px
  padding: 10px 12px
  min-width: 0
  background: var(--game-detail-inset)

  span
    display: flex
    align-items: center
    gap: 6px
    color: var(--game-catalog-muted)
    font-size: 12px

    i
      width: 12px
      color: var(--game-catalog-accent)
      text-align: center
      font-size: 11px

      &[data-game-quickview-date-icon]
        color: var(--game-catalog-muted)

  strong
    color: var(--game-catalog-text)
    font-size: 14px
    line-height: 1.5
    overflow-wrap: anywhere

  &--status
    span i,
    strong
      color: var(--game-detail-status)

  &--size
    span i,
    strong
      color: var(--game-detail-size)

.game-quickview__download,
.game-quickview__open-page
  display: flex
  align-items: center
  justify-content: center
  gap: 8px
  width: 100%
  min-height: 44px
  padding: 8px 12px
  border-radius: 6px
  cursor: pointer
  font-size: 14px
  line-height: 1.5
  font-weight: 700
  transition: filter .2s ease, transform .2s ease, border-color .2s ease, background .2s ease

  &:hover
    filter: brightness(1.06)
    transform: translateY(-1px)

.game-quickview__download
  margin-top: 14px
  border: 1px solid var(--game-detail-button)
  background: var(--game-detail-button)
  color: var(--game-catalog-on-accent)
  box-shadow: 0 4px 12px unquote('rgba(var(--game-catalog-accent-rgb), .16)')

  &:hover
    color: var(--game-catalog-on-accent)

.game-quickview__open-page
  margin-top: 10px
  border: 1px solid var(--game-catalog-line)
  background: var(--game-detail-inset)
  color: var(--game-catalog-text)

  &:hover
    border-color: unquote('rgba(var(--game-catalog-accent-rgb), .45)')
    background: unquote('rgba(var(--game-catalog-accent-rgb), .08)')
    color: var(--game-catalog-accent)

.game-quickview__error
  display: grid
  min-height: 240px
  color: var(--game-catalog-muted)
  text-align: center
  place-items: center

@keyframes gameQuickviewIn
  from
    opacity: 0
    transform: translateY(10px) scale(.985)
  to
    opacity: 1
    transform: translateY(0) scale(1)

@media screen and (max-width: 1280px)
  #content-inner .home-section-grid
    grid-template-columns: repeat(4, minmax(0, 1fr))

@media screen and (max-width: 1050px)
  #content-inner .home-section-grid
    grid-template-columns: repeat(3, minmax(0, 1fr))

  .game-quickview
    width: calc(100vw - 30px)

  .game-quickview__body
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, .9fr)

@media screen and (max-width: 768px)
  #content-inner.layout:has(> .home-catalog-section)
    overflow-x: clip
    padding-right: 10px
    padding-left: 10px

  .home-notice
    gap: 6px

  .home-notice__label
    flex-basis: 52px
    flex-direction: column
    gap: 8px

    > i
      font-size: 18px

  .home-notice__body
    align-items: stretch
    flex-direction: column
    gap: 8px
    padding: 10px

  .home-notice__text
    font-size: 13px
    line-height: 1.6
    white-space: normal
    overflow-wrap: anywhere

  .home-notice__links
    display: grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: 8px

    a
      gap: 5px
      padding: 5px 6px
      min-width: 0
      min-height: 44px
      font-size: 12px

  .home-game-catalog-head
    gap: 10px
    padding: 11px 12px

  .home-game-catalog-head__title
    > h2
      font-size: 16px

    > span
      display: none

  .home-game-catalog-head__guide
    padding: 7px 9px
    font-size: 12px

  .home-catalog-section__header
    gap: 10px
    margin-bottom: 10px
    padding: 4px 12px

  .home-catalog-section__more
    min-height: 44px
    font-size: 12px

  .home-catalog-section__heading
    gap: 7px

    h2
      font-size: 17px

  .home-catalog-section__eyebrow
    padding-left: 8px
    font-size: 11px

  #content-inner .home-section-grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: 14px

    > .home-section-card
      height: auto

      .post_cover,
      .post_cover.right
        flex-basis: auto
        height: auto
        aspect-ratio: unquote('16 / 9')

      > .recent-post-info
        flex-basis: 110px
        padding: 10px 10px 12px
        min-height: 110px

        > .article-title
          font-size: 13px
          line-height: 1.5
          -webkit-line-clamp: 4

        > .article-meta-wrap
          margin-bottom: 5px
          font-size: 10px

  .game-quickview
    width: 100vw
    max-width: none
    height: 100dvh
    max-height: none
    border: 0
    border-radius: 0

  .game-quickview__frame
    grid-template-rows: 52px minmax(0, 1fr)

  .game-quickview__header
    padding: 0 9px 0 14px

  .game-quickview__body
    display: flex
    overflow-x: hidden
    overflow-y: auto
    flex-direction: column

  .game-quickview__summary,
  .game-quickview__main
    flex: 0 0 auto
    overflow: visible
    min-height: auto

  .game-quickview__summary
    order: -1
    padding: 18px 16px
    border-bottom: 1px solid var(--game-catalog-line)
    border-left: 0

  .game-quickview__main
    padding: 16px 14px 30px

  .game-quickview__identity h2
    font-size: 16px
    -webkit-line-clamp: 3

  .game-quickview__cover
    aspect-ratio: 16 / 9

  .game-quickview__info
    margin-top: 16px

  .game-quickview__info-item
    min-height: 64px
    padding: 10px 12px

@media screen and (max-width: 420px)
  #content-inner .home-section-grid
    grid-template-columns: 1fr

    > .home-section-card
      height: auto

      > .recent-post-info
        flex-basis: 110px
        min-height: 110px
