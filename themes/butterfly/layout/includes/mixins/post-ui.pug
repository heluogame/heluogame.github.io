mixin postCardDateMeta(article)
  if (theme.post_meta.page.date_type === 'both')
    i.far.fa-calendar-alt
    span.article-meta-label=_p('post.created')
    time.post-meta-date-created(datetime=date_xml(article.date) title=_p('post.created') + ' ' + full_date(article.date))=date(article.date, config.date_format)
    span.article-meta-separator |
    i.fas.fa-history
    span.article-meta-label=_p('post.updated')
    time.post-meta-date-updated(datetime=date_xml(article.updated) title=_p('post.updated') + ' ' + full_date(article.updated))=date(article.updated, config.date_format)
  else
    - let data_type_updated = theme.post_meta.page.date_type === 'updated'
    - let date_type = data_type_updated ? 'updated' : 'date'
    - let date_icon = data_type_updated ? 'fas fa-history' :'far fa-calendar-alt'
    - let date_title = data_type_updated ? _p('post.updated') : _p('post.created')
    i(class=date_icon)
    span.article-meta-label=date_title
    time(datetime=date_xml(article[date_type]) title=date_title + ' ' + full_date(article[date_type]))=date(article[date_type], config.date_format)

mixin postUI(posts, catalogMode, quickviewConfig)
  - const articleList = posts ? (posts.data || posts) : page.posts.data
  - const platformOptions = { android: { label: '安卓', icon: 'fa-android' }, ios: { label: 'iOS', icon: 'fa-apple' }, windows: { label: 'Windows', icon: 'fa-windows' } }
  each article , index in articleList
    -
      let link = article.link || article.path
      let title = article.title || _p('no_title')
      const position = theme.cover.position
      let leftOrRight = position === 'both'
        ? index%2 == 0 ? 'left' : 'right'
        : position === 'left' ? 'left' : 'right'
      let post_cover = article.cover
      let no_cover = article.cover === false || !theme.cover.index_enable ? 'no-cover' : ''
        const isHomeSectionCard = catalogMode === 'home-section'
        const isPortraitCard = isHomeSectionCard && quickviewConfig && quickviewConfig.orientation === 'portrait'
        const isGameCatalogCard = isHomeSectionCard && Boolean(quickviewConfig) && quickviewConfig.popup !== false
        const portraitData = isPortraitCard ? catalog_portrait_data(article) : null
        const cardMeta = isGameCatalogCard ? catalog_card_meta(article) : null
        const cardTags = cardMeta ? cardMeta.tags : []
        const cardReview = cardMeta ? cardMeta.review : ''
        const cardStatus = cardMeta ? cardMeta.status : ''
        const cardSize = cardMeta ? cardMeta.size : ''
        const cardPlatforms = cardMeta ? cardMeta.platforms : []
        const gameBadge = (isGameCatalogCard || isPortraitCard) && typeof article.game_badge === 'string' ? article.game_badge.trim() : ''
        const gamePlatforms = (isGameCatalogCard || isPortraitCard) && Array.isArray(article.game_platforms) ? [...new Set(article.game_platforms.filter(value => typeof value === 'string').map(value => value.trim().toLowerCase()))].filter(value => Object.prototype.hasOwnProperty.call(platformOptions, value)).map(value => platformOptions[value]) : []
        const catalogCardClass = isHomeSectionCard ? `home-section-card uses-game-card-style${isGameCatalogCard ? ' has-game-quickview' : ''}${isPortraitCard ? ' is-portrait' : ''}` : ''
    -
    .recent-post-item(class=catalogCardClass data-card-orientation=isHomeSectionCard ? (isPortraitCard ? 'portrait' : 'landscape') : null data-quickview-config=isGameCatalogCard ? JSON.stringify(quickviewConfig) : null data-game-url=isGameCatalogCard ? url_for(link) : null data-game-title=isGameCatalogCard ? title : null data-game-cover=isGameCatalogCard && post_cover ? url_for(post_cover) : null data-game-tags=isGameCatalogCard ? JSON.stringify(cardTags) : null data-game-review=isGameCatalogCard ? cardReview : null data-game-status=isGameCatalogCard ? cardStatus : null data-game-size=isGameCatalogCard ? cardSize : null data-game-platforms=isGameCatalogCard ? cardPlatforms.join(' / ') : null)
      if post_cover && theme.cover.index_enable
        .post_cover(class=leftOrRight)
          a(href=url_for(link) title=title data-no-pjax=isGameCatalogCard ? 'true' : null)
            img.post_bg(src=url_for(post_cover) onerror=`this.onerror=null;this.src='`+ url_for(theme.error_img.post_page) + `'` alt=title)
            if gameBadge || gamePlatforms.length
              .game-card-markers
                if gameBadge
                  span.game-card-badge(title=gameBadge)= gameBadge
                if gamePlatforms.length
                  .game-card-platforms
                    each platform in gamePlatforms
                      span.game-card-platform(role='img' aria-label=`支持${platform.label}` data-tooltip=`支持${platform.label}`)
                        i.fa-brands(class=platform.icon aria-hidden='true')
      else if isPortraitCard
        .post_cover.portrait-card__placeholder
          a(href=url_for(link) title=title aria-label=title data-no-pjax=isGameCatalogCard ? 'true' : null)
            i.fa-regular.fa-image(aria-hidden='true')
      if isPortraitCard
        .portrait-card__body
          h2.portrait-card__heading
            if theme.post_meta.page.date_type
              span.portrait-card__date
                span.post-meta-date
                  +postCardDateMeta(article)
              span.portrait-card__separator(aria-hidden='true') |
            a.portrait-card__title(href=url_for(link) title=title data-no-pjax=isGameCatalogCard ? 'true' : null)= title
          if portraitData.tags.length
            .portrait-card__tags
              each tag in portraitData.tags
                span(title=tag)= tag
          .portrait-card__actions
            if portraitData.downloads.length
              .portrait-card__download-box
                i.fa-solid.fa-download(aria-hidden='true')
                .portrait-card__downloads
                  each download in portraitData.downloads
                    button.post-pan-download__item.portrait-card__download(type='button' class=`is-${download.type}` data-pan-p=download.payload || null data-pan-s=download.iv || null data-pan-k=download.key || null disabled=download.disabled aria-disabled=download.disabled ? 'true' : null aria-haspopup=download.disabled ? null : 'dialog' title=download.disabled ? `${download.label}链接待补充` : download.label)
                      span.post-pan-download__mark
                        img(src=url_for(download.image) alt='' loading='lazy')
                      span.post-pan-download__name= download.label
            else
              a.portrait-card__open(href=url_for(link) data-no-pjax=isGameCatalogCard ? 'true' : null)
                span 查看详情
                i.fa-solid.fa-arrow-right(aria-hidden='true')
      .recent-post-info(class=no_cover)
        a.article-title(href=url_for(link) title=title data-no-pjax=isGameCatalogCard ? 'true' : null)= title
        .article-meta-wrap
          if (is_home() && (article.top || article.sticky > 0))
            span.article-meta
              i.fas.fa-thumbtack.sticky
              span.sticky= _p('sticky')
              span.article-meta-separator |
          if (theme.post_meta.page.date_type)
            span.post-meta-date
              +postCardDateMeta(article)
          if (!isHomeSectionCard && theme.post_meta.page.categories && article.categories.data.length > 0)
            span.article-meta
              span.article-meta-separator |
              i.fas.fa-inbox
              each item, index in article.categories.data
                a(href=url_for(item.path)).article-meta__categories #[=item.name]
                if (index < article.categories.data.length - 1)
                  i.fas.fa-angle-right.article-meta-link
          if (theme.post_meta.page.tags && article.tags.data.length > 0)
            span.article-meta.tags
              span.article-meta-separator |
              i.fas.fa-tag
              each item, index in article.tags.data
                a(href=url_for(item.path)).article-meta__tags #[=item.name]
                if (index < article.tags.data.length - 1)
                  span.article-meta-link #[='•']
          
          mixin countBlockInIndex
            - needLoadCountJs = true
            span.article-meta
              span.article-meta-separator |
              i.fas.fa-comments
              if block
                block
              span.article-meta-label= ' ' + _p('card_post_count')
          
          if theme.comments.card_post_count
            case theme.comments.use[0]
              when 'Disqus'
                +countBlockInIndex
                  a(href=full_url_for(link) + '#disqus_thread')
                    i.fa-solid.fa-spinner.fa-spin
              when 'Disqusjs'
                +countBlockInIndex
                  a(href=full_url_for(link) + '#disqusjs')
                    span.disqus-comment-count(data-disqus-url=full_url_for(link))
                      i.fa-solid.fa-spinner.fa-spin
              when 'Valine'
                +countBlockInIndex
                  a(href=url_for(link) + '#post-comment')
                    span.valine-comment-count(data-xid=url_for(link))
                      i.fa-solid.fa-spinner.fa-spin
              when 'Waline'
                +countBlockInIndex
                  a(href=url_for(link) + '#post-comment')
                    span.waline-comment-count(id=url_for(link))
                      i.fa-solid.fa-spinner.fa-spin
              when 'Twikoo'
                +countBlockInIndex
                  a.twikoo-count(href=url_for(link) + '#post-comment')
                    i.fa-solid.fa-spinner.fa-spin
              when 'Facebook Comments'
                +countBlockInIndex
                  a(href=url_for(link) + '#post-comment')
                    span.fb-comments-count(data-href=urlNoIndex(article.permalink))
              when 'Remark42'
                +countBlockInIndex
                  a(href=url_for(link) + '#post-comment')
                    span.remark42__counter(data-url=urlNoIndex(article.permalink))
                      i.fa-solid.fa-spinner.fa-spin
              when 'Artalk'
                +countBlockInIndex
                  a(href=url_for(link) + '#post-comment')
                    span.artalk-count(data-page-key=url_for(link))
                      i.fa-solid.fa-spinner.fa-spin

        //- Display the article introduction on homepage
        case theme.index_post_content.method
          when false
            - break
          when 1
            .content!= article.description
          when 2
            if article.description
              .content!= article.description
            else
              - const content = strip_html(article.content)
              - let expert = content.substring(0, theme.index_post_content.length) 
              - content.length > theme.index_post_content.length ? expert += ' ...' : ''
              .content!= expert
          default
            - const content = strip_html(article.content)
            - let expert = content.substring(0, theme.index_post_content.length) 
            - content.length > theme.index_post_content.length ? expert += ' ...' : ''
            .content!= expert

    if !catalogMode && theme.ad && theme.ad.index
      if (index + 1) % 3 == 0
        .recent-post-item.ads-wrap!=theme.ad.index
