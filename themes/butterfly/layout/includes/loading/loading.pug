- const isMaintenanceMode = theme.maintenance_mode && theme.maintenance_mode.enable
- const maintenanceText = isMaintenanceMode ? (theme.maintenance_mode.text || '网站维护中...') : _p('loading')
#loading-box(class=isMaintenanceMode ? 'maintenance-mode' : '')
  .loading-left-bg
  .loading-right-bg
  .spinner-box
    .configure-border-1
      .configure-core
    .configure-border-2
      .configure-core
    .loading-word= maintenanceText

